;;; thb-open-test.el --- Shared GUI opener tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(load (expand-file-name "../lisp/thb-open.el"
                        (file-name-directory (or load-file-name buffer-file-name)))
      nil t)

(ert-deftest thb-open-aerospace-uses-argv-without-a-shell ()
  (let (captured)
    (cl-letf (((symbol-function 'call-process)
               (lambda (&rest args)
                 (setq captured args)
                 (insert "ok")
                 0)))
      (should (equal (thb-open--aerospace "focus" "--window-id" "42") "ok"))
      (should (equal captured '("aerospace" nil t nil "focus" "--window-id" "42"))))))

(ert-deftest thb-open-aerospace-reports-command-failure ()
  (cl-letf (((symbol-function 'call-process)
             (lambda (&rest _) (insert "permission denied") 1)))
    (should-error (thb-open--aerospace "focus"))))

(ert-deftest thb-open-json-requires-an-array ()
  (cl-letf (((symbol-function 'thb-open--aerospace) (lambda (&rest _) "{}")))
    (should-error (thb-open--json "list-windows")))
  (cl-letf (((symbol-function 'thb-open--aerospace) (lambda (&rest _) "[]")))
    (should-not (thb-open--json "list-windows"))))

(ert-deftest thb-open-rightmost-empty-slot-includes-unused-workspaces ()
  (let ((thb-open-workspaces '("1" "2" "3" "9" "10")))
    (cl-letf (((symbol-function 'thb-open--json)
               (lambda (&rest _) '(((workspace . "1")) ((workspace . "10"))))))
      (should (equal (thb-open--empty-workspace) "9")))))

(ert-deftest thb-open-workspace-order-is-explicit-not-lexical ()
  (let ((thb-open-workspaces '("1" "2" "10")))
    (cl-letf (((symbol-function 'thb-open--json) (lambda (&rest _) nil)))
      (should (equal (thb-open--empty-workspace) "10")))))

(ert-deftest thb-open-no-empty-workspace-is-an-error ()
  (let ((thb-open-workspaces '("1")))
    (cl-letf (((symbol-function 'thb-open--json)
               (lambda (&rest _) '(((workspace . "1"))))))
      (should-error (thb-open--empty-workspace) :type 'user-error))))

(ert-deftest thb-open-missing-workspace-data-is-not-empty-space ()
  (cl-letf (((symbol-function 'thb-open--json)
             (lambda (&rest _) '(((window-id . 1))))))
    (should-error (thb-open--empty-workspace))))

(ert-deftest thb-open-rejects-terminal-child-and-auxiliary-frames ()
  (dolist (case '((terminal nil nil nil nil t nil)
                  (child t parent nil nil t nil)
                  (completion t nil t nil t nil)
                  (no-other t nil nil t t nil)
                  (minibuffer t nil nil nil only nil)
                  (normal t nil nil nil t t)))
    (pcase-let ((`(,frame ,gui ,parent ,no-focus ,no-other ,minibuffer ,expected) case))
      (cl-letf (((symbol-function 'frame-live-p) (lambda (_) t))
                ((symbol-function 'display-graphic-p) (lambda (_) gui))
                ((symbol-function 'frame-parent) (lambda (_) parent))
                ((symbol-function 'frame-parameter)
                 (lambda (_ key)
                   (pcase key
                     ('no-accept-focus no-focus)
                     ('no-other-frame no-other)
                     ('minibuffer minibuffer)))))
        (should (eq (not (null (thb-open--normal-frame-p frame))) expected))))))

(ert-deftest thb-open-prefers-the-selected-normal-frame ()
  (cl-letf (((symbol-function 'selected-frame) (lambda () 'selected))
            ((symbol-function 'thb-open--normal-frame-p) (lambda (_) t))
            ((symbol-function 'frame-list-z-order) (lambda () '(other selected))))
    (should (eq (thb-open--existing-frame) 'selected))))

(ert-deftest thb-open-falls-back-to-normal-frame-in-z-order ()
  (cl-letf (((symbol-function 'selected-frame) (lambda () 'terminal))
            ((symbol-function 'thb-open--normal-frame-p)
             (lambda (f) (memq f '(front back))))
            ((symbol-function 'frame-list) (lambda () '(completion front back)))
            ((symbol-function 'frame-parameter) (lambda (&rest _) "gui-display"))
            ((symbol-function 'frame-list-z-order)
             (lambda (display)
               (should (equal display "gui-display"))
               '(completion front back))))
    (should (eq (thb-open--existing-frame) 'front))))

(ert-deftest thb-open-window-id-is-not-the-emacs-window-id ()
  (let ((title "Original") seen)
    (cl-letf (((symbol-function 'frame-parameter) (lambda (&rest _) title))
              ((symbol-function 'set-frame-parameter)
               (lambda (_ _ value) (setq title value)))
              ((symbol-function 'redisplay) #'ignore)
              ((symbol-function 'thb-open--json)
               (lambda (&rest _)
                 (setq seen title)
                 (list `((window-title . ,title) (window-id . 23536))))))
      (should (equal (thb-open--window-id 'frame) "23536"))
      (should (string-prefix-p "thbemacs-open-" seen))
      (should (equal title "Original")))))

(ert-deftest thb-open-window-title-is-restored-on-error ()
  (let ((title "Original"))
    (cl-letf (((symbol-function 'frame-parameter) (lambda (&rest _) title))
              ((symbol-function 'set-frame-parameter)
               (lambda (_ _ value) (setq title value)))
              ((symbol-function 'redisplay) #'ignore)
              ((symbol-function 'thb-open--json) (lambda (&rest _) (error "denied"))))
      (should-error (thb-open--window-id 'frame))
      (should (equal title "Original")))))

(ert-deftest thb-open-reuses-and-focuses-without-moving-existing-frame ()
  (let (calls selected)
    (cl-letf (((symbol-function 'thb-open--existing-frame) (lambda () 'existing))
              ((symbol-function 'thb-open--window-id) (lambda (_) "42"))
              ((symbol-function 'thb-open--empty-workspace)
               (lambda () (ert-fail "must not look for workspace")))
              ((symbol-function 'make-frame)
               (lambda (&rest _) (ert-fail "must not create frame")))
              ((symbol-function 'thb-open--aerospace)
               (lambda (&rest args) (push args calls)))
              ((symbol-function 'select-frame-set-input-focus)
               (lambda (frame &rest _) (setq selected frame))))
      (should (eq (thb-open--focus-frame) 'existing))
      (should (equal calls '(("focus" "--window-id" "42"))))
      (should (eq selected 'existing)))))

(ert-deftest thb-open-creates-a-gui-frame-on-the-empty-workspace ()
  (let (calls parameters)
    (cl-letf (((symbol-function 'thb-open--existing-frame) (lambda () nil))
              ((symbol-function 'thb-open--empty-workspace) (lambda () "7"))
              ((symbol-function 'make-frame)
               (lambda (params) (setq parameters params) 'created))
              ((symbol-function 'thb-open--window-id) (lambda (_) "99"))
              ((symbol-function 'thb-open--aerospace)
               (lambda (&rest args) (push args calls)))
              ((symbol-function 'select-frame-set-input-focus) #'ignore))
      (should (eq (thb-open--focus-frame) 'created))
      (should (eq (alist-get 'window-system parameters) 'ns))
      (should (equal (reverse calls)
                     '(("move-node-to-workspace" "--window-id" "99" "--" "7")
                       ("focus" "--window-id" "99")))))))

(ert-deftest thb-open-no-workspace-does-not-create-a-frame ()
  (cl-letf (((symbol-function 'thb-open--existing-frame) (lambda () nil))
            ((symbol-function 'thb-open--empty-workspace) (lambda () (user-error "full")))
            ((symbol-function 'make-frame)
             (lambda (&rest _) (ert-fail "must not create frame"))))
    (should-error (thb-open--focus-frame) :type 'user-error)))

(defmacro thb-open-test--without-gui (&rest body)
  "Run BODY with GUI focus stubbed; file operations remain real."
  (declare (indent 0) (debug t))
  `(cl-letf (((symbol-function 'thb-open--focus-frame) (lambda () (selected-frame)))
             ((symbol-function 'select-frame-set-input-focus) #'ignore))
     (save-window-excursion ,@body)))

(ert-deftest thb-open-preserves-a-modified-existing-file-buffer ()
  (let* ((directory (make-temp-file "thb-open-" t))
         (path (expand-file-name "quotes ' and \" unicode λ.md" directory))
         buffer)
    (unwind-protect
        (progn
          (write-region "on disk" nil path nil 'silent)
          (setq buffer (find-file-noselect path))
          (with-current-buffer buffer (erase-buffer) (insert "unsaved"))
          (thb-open-test--without-gui
            (should (eq (thb-open path) buffer))
            (should (eq (current-buffer) buffer))
            (should (buffer-modified-p))
            (should (equal (buffer-string) "unsaved"))))
      (when (buffer-live-p buffer)
        (with-current-buffer buffer (set-buffer-modified-p nil))
        (kill-buffer buffer))
      (delete-directory directory t))))

(ert-deftest thb-open-opens-directories-in-dired ()
  (let ((directory (make-temp-file "thb-open-dired-" t)) buffer)
    (unwind-protect
        (thb-open-test--without-gui
          (setq buffer (thb-open directory))
          (should (derived-mode-p 'dired-mode))
          (should (equal (directory-file-name default-directory) directory)))
      (when (buffer-live-p buffer) (kill-buffer buffer))
      (delete-directory directory t))))

(ert-deftest thb-open-picker-starts-at-the-requested-directory ()
  (let ((directory (make-temp-file "thb-open-picker-" t)) buffer prompt-args)
    (unwind-protect
        (thb-open-test--without-gui
          (cl-letf (((symbol-function 'read-file-name)
                     (lambda (&rest args) (setq prompt-args args) directory)))
            (setq buffer (thb-open nil directory))
            (should (equal (nth 1 prompt-args) (file-name-as-directory directory)))
            (should (eq (nth 3 prompt-args) t))))
      (when (buffer-live-p buffer) (kill-buffer buffer))
      (delete-directory directory t))))

(ert-deftest thb-open-cancellation-releases-the-request-guard ()
  (thb-open-test--without-gui
    (cl-letf (((symbol-function 'read-file-name) (lambda (&rest _) (signal 'quit nil))))
      (should (eq (condition-case nil (thb-open) (quit 'cancelled)) 'cancelled))
      (should-not thb-open--busy))))

(ert-deftest thb-open-rejects-reentrant-requests ()
  (let ((thb-open--busy t))
    (should-error (thb-open "/tmp/not-opened") :type 'user-error)))

(ert-deftest thb-open-preserves-tramp-target-without-local-rewriting ()
  (let ((path "/ssh:pi-remote:/home/user/report.md") opened)
    (thb-open-test--without-gui
      (cl-letf (((symbol-function 'file-exists-p) (lambda (_) t))
                ((symbol-function 'file-directory-p) (lambda (_) nil))
                ((symbol-function 'find-file) (lambda (name &rest _) (setq opened name))))
        (thb-open path)
        (should (equal opened path))))))

(ert-deftest thb-open-rejects-missing-target ()
  (thb-open-test--without-gui
    (cl-letf (((symbol-function 'file-exists-p) (lambda (_) nil)))
      (should-error (thb-open "/missing-file") :type 'user-error))))

